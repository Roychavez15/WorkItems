@page "/users"
@inject UserService UserService

<h3>Usuarios</h3>

<button class="btn btn-primary mb-3" @onclick="ShowCreateUserModal">Crear Nuevo Usuario</button>

@if (users == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Username</th>
                <th>Nombre Completo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.Username</td>
                    <td>@user.FullName</td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Modal Crear Usuario -->
@if (showUserModal)
{
    <div class="modal-background">
        <div class="modal-dialog">
            <h4>Nuevo Usuario</h4>
            <div class="form-group">
                <label>Username:</label>
                <input class="form-control" @bind="newUser.Username" />
            </div>
            <div class="form-group">
                <label>Nombre Completo:</label>
                <input class="form-control" @bind="newUser.FullName" />
            </div>
            <button class="btn btn-success mt-2" @onclick="CreateUser">Crear</button>
            <button class="btn btn-secondary mt-2" @onclick="CloseUserModal">Cancelar</button>
        </div>
    </div>
}

@code {
    private List<User> users;
    private User newUser = new();
    private bool showUserModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        users = await UserService.GetUsersAsync();
    }

    private void ShowCreateUserModal()
    {
        newUser = new User();
        showUserModal = true;
    }

    private void CloseUserModal()
    {
        showUserModal = false;
    }

    private async Task CreateUser()
    {
        await UserService.CreateUserAsync(newUser);
        await LoadUsers();
        CloseUserModal();
    }
}